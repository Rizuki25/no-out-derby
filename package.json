{
  "name": "no-out-derby",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "No-Out Derby (Futsal Pantul) - 2D Pixel Arcade Sports Game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "VITE_CRAZYGAMES=true tsc --noEmit && VITE_CRAZYGAMES=true vite build",
    "pack:crazygames": "npm run build:crazygames && rm -f crazygames-build.zip && (cd dist && zip -r ../crazygames-build.zip .)",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@upstash/redis": "^1.41.0"
  }
}
